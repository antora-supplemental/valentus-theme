<nav class="breadcrumbs adt-breadcrumbs" aria-label="Breadcrumb: component, version, and page path">
  <ul>
    {{#if site.homeUrl}}
    <li class="adt-breadcrumb-home">
      {{! Real "/" so a drag-select copies as a path (not an SVG / CSS pseudo). }}
      <a href="{{{relativize site.homeUrl}}}" class="adt-breadcrumb-home-link" title="Site home" aria-label="Site home">/</a>
    </li>
    {{/if}}
    <li class="adt-breadcrumb-col adt-breadcrumb-masthead">
      {{> adt-bc-cluster}}
    </li>
    {{> adt-bc-trail}}
  </ul>
</nav>
