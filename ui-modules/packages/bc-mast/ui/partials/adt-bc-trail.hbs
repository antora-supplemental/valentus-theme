{{#with (adt-bc-trail-crumbs page.breadcrumbs)}}
{{#each this}}
<li class="adt-breadcrumb-sep" aria-hidden="true">/</li>
<li class="adt-breadcrumb-trail{{#if @last}} adt-breadcrumb-trail--current{{/if}}">
{{~#if @last~}}
<span class="adt-breadcrumb-trail-text" aria-current="page">{{{./content}}}</span>
{{~else if (and ./url (eq ./urlType 'internal'))~}}
<a class="adt-breadcrumb-trail-link" href="{{{relativize ./url}}}">{{{./content}}}</a>
{{~else~}}
<span class="adt-breadcrumb-trail-text">{{{./content}}}</span>
{{~/if~}}
</li>
{{/each}}
{{/with}}