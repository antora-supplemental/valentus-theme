{
  id: "doc-layout",
  name: "Doc layout body and styles",
  version: "1.0.0",
  type: "ui-module",
  description: "Body/nav/article layout, site-doc-layout.css, and footer chrome for the debranded doc site pattern.",
  repository: "https://github.com/antora-supplemental/valentus-theme",
  requires: ["header-chrome"],
  recommends: ["color-scheme", "read-width", "font-size"],
  conflicts: [],
  slots: {
    head: {
      stylesheets: ["css/valentus-chrome.css", "css/site-doc-layout.css", "css/site-visual.css"],
    },
    foot: {
      scripts: ["js/site-page-toc.js", "js/site-visual.js", "js/valentus-table-scroll.js", "js/valentus-breadcrumb-scroll.js"],
    },
  },
  ui: {
    partials: {
      provide: ["valentus-doc-toolbar", "valentus-tool-band"],
      replace: ["body", "nav", "nav-menu", "main", "article", "footer-content", "edit-this-page"],
    },
  },
}
