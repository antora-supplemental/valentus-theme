{{!-- Favicons. Valentus ships a neutral placeholder (img/favicon.svg, favicon.ico,
  apple-touch-icon.png); replace those three paths via ui.supplemental_files, or
  point site.keys.favicon at another img/ basename. See guide: Header logo. --}}
{{#if site.keys.favicon}}
<link rel="icon" href="{{{uiRootPath}}}/img/{{site.keys.favicon}}">
{{else}}
<link rel="icon" href="{{{uiRootPath}}}/img/favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{{uiRootPath}}}/img/favicon.ico" sizes="32x32">
{{/if}}
<link rel="apple-touch-icon" href="{{{uiRootPath}}}/img/apple-touch-icon.png">
