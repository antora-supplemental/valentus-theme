<div class="adt-read-width" role="group" aria-label="Reading width">
  <button type="button" class="adt-read-width-btn" data-adt-read-width="narrow" title="Narrow (~68 characters)" aria-label="Narrow reading width" aria-pressed="false">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="5" y="2.5" width="6" height="11" rx="1"/></svg>
  </button>
  <button type="button" class="adt-read-width-btn" data-adt-read-width="comfortable" title="Comfortable (~82 characters)" aria-label="Comfortable reading width" aria-pressed="true">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3.5" y="2.5" width="9" height="11" rx="1"/></svg>
  </button>
  <button type="button" class="adt-read-width-btn" data-adt-read-width="wide" title="Wide (~100 characters)" aria-label="Wide reading width" aria-pressed="false">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="2" y="2.5" width="12" height="11" rx="1"/></svg>
  </button>
</div>
