{
  "name": "valentus-theme",
  "version": "4.2.0",
  "description": "Valentus: Antora doc-site layout (packages/valentus-layout) and Valentus Paint (paint/), split on the --cs-* token contract of @antora-supplemental/color-scheme.",
  "private": true,
  "keywords": [
    "antora",
    "antora-theme",
    "documentation",
    "asciidoc"
  ],
  "homepage": "https://antora-supplemental.github.io/valentus-theme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antora-supplemental/valentus-theme.git"
  },
  "bugs": {
    "url": "https://github.com/antora-supplemental/valentus-theme/issues"
  },
  "license": "MIT",
  "author": "Ryan Johnson (https://github.com/AMDphreak)",
  "files": [
    "paint/**/*",
    "packages/valentus-layout/**/*",
    "ui-modules/**/*"
  ],
  "scripts": {
    "build": "antora antora-playbook.yml",
    "build:local": "antora antora-playbook-local.yml",
    "build:visual-demo": "antora antora-playbook-visual-demo.yml",
    "build:ui-modules": "antora antora-playbook-ui-modules.yml",
    "preview": "antora antora-playbook.yml",
    "serve": "pnpm build && npx http-server build/site -p 8080 -o",
    "serve:visual-demo": "pnpm build:visual-demo && npx http-server build/site -p 8081 -o",
    "clean": "rimraf build .cache",
    "ui-modules:validate": "node ui-modules/scripts/validate-ui-modules.mjs",
    "brand:validate": "node node_modules/@antora-supplemental/brand-placeholder/scripts/validate-theme.mjs packages/valentus-layout/supplemental-ui --strict && node node_modules/@antora-supplemental/brand-placeholder/scripts/validate-theme.mjs ui-modules/packages --strict",
    "themed-svg:sync": "node scripts/sync-themed-svg-runtime.mjs",
    "test": "node --test test/*.test.js paint/test/*.test.js",
    "paint:validate": "node node_modules/@antora-supplemental/color-scheme/scripts/validate-paint.mjs paint/css/valentus-paint.css --strict --extra=.valentus-,.cards,.tile",
    "paint:bake": "node scripts/bake-paint.mjs"
  },
  "devDependencies": {
    "@antora-supplemental/antora-search-chat": "github:antora-supplemental/antora-search-chat#v0.1.20",
    "@antora-supplemental/brand-placeholder": "github:antora-supplemental/antora-ui-chassis#brand-placeholder-v0.1.0&path:packages/brand-placeholder",
    "@antora-supplemental/color-scheme": "github:antora-supplemental/antora-ui-chassis#color-scheme-v0.5.3&path:packages/color-scheme",
    "@antora-supplemental/light-dark-mode": "github:antora-supplemental/antora-ui-chassis#light-dark-mode-v0.1.3&path:packages/light-dark-mode",
    "@antora/lunr-extension": "1.0.0-alpha.12",
    "@asciidoctor/tabs": "^1.0.0-beta.6",
    "@dev-centr/themed-svg": "0.1.1",
    "antora": "^3.1.14",
    "biome": "^0.3.3",
    "http-server": "^14.1.1",
    "json5": "^2.2.3",
    "rimraf": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "puppeteer"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "main": "paint/lib/index.js",
  "antoraRegistry": {
    "provides": {
      "valentus-layout-markup": "4"
    },
    "uses": {
      "antora-ui-model": "3",
      "color-scheme-tokens": "^0.5"
    },
    "worksWith": {
      "@antora-supplemental/color-scheme": ">=0.4.0"
    }
  }
}
