<div class="valentus-font-size" role="group" aria-label="Text size">
  <button type="button" class="valentus-font-size-btn" data-valentus-font-size="small" title="Smaller text" aria-label="Smaller text" aria-pressed="false">
    <span class="valentus-font-size-glyph valentus-font-size-glyph--sm" aria-hidden="true">A</span>
  </button>
  <button type="button" class="valentus-font-size-btn" data-valentus-font-size="medium" title="Default text size" aria-label="Default text size" aria-pressed="true">
    <span class="valentus-font-size-glyph valentus-font-size-glyph--md" aria-hidden="true">A</span>
  </button>
  <button type="button" class="valentus-font-size-btn" data-valentus-font-size="large" title="Larger text" aria-label="Larger text" aria-pressed="false">
    <span class="valentus-font-size-glyph valentus-font-size-glyph--lg" aria-hidden="true">A</span>
  </button>
</div>
