// Valentus UI module catalog — chrome, composed layout and paint; color scheme mechanism is the chassis color-scheme extension.
{
  schema: "1.0",
  repository: "https://github.com/antora-supplemental/valentus-theme",
  modules: [
    {
      id: "vcs-icons",
      path: "packages/vcs-icons",
      manifest: "ui-module.json5",
    },
    {
      id: "bc-mast",
      path: "packages/bc-mast",
      manifest: "ui-module.json5",
    },
    {
      id: "edit-crumb",
      path: "packages/edit-crumb",
      manifest: "ui-module.json5",
    },
    {
      id: "header-chrome",
      path: "packages/header-chrome",
      manifest: "ui-module.json5",
    },
    {
      id: "doc-layout",
      path: "packages/doc-layout",
      manifest: "ui-module.json5",
    },
    {
      id: "read-width",
      path: "packages/read-width",
      manifest: "ui-module.json5",
    },
    {
      id: "font-size",
      path: "packages/font-size",
      manifest: "ui-module.json5",
    },
  ],
  recipes: [
    {
      id: "valentus-site",
      path: "recipes/valentus-site.json5",
    },
  ],
  pairsWith: [
    {
      id: "color-scheme",
      repository: "https://github.com/antora-supplemental/antora-ui-chassis",
      description: "Chassis Antora extension (@antora-supplemental/color-scheme): FOUC hook, persistence, toggle behavior. Valentus places the toggle (toggle: placed) and paints it. Replaces deprecated antora-dark-mode.",
    },
  ],
}
