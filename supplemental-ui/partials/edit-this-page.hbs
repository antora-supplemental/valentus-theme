{{#if (and page.fileUri (not env.CI))}}
<div class="edit-this-page valentus-edit-this-page">
  <a class="valentus-edit-this-page-link" href="{{page.fileUri}}"><span class="valentus-edit-github-icon" aria-hidden="true">{{> valentus-icon-github-inline}}</span> Edit this page</a>
</div>
{{else if (and page.editUrl (or env.FORCE_SHOW_EDIT_PAGE_LINK (not page.origin.private)))}}
<div class="edit-this-page valentus-edit-this-page">
  <a class="valentus-edit-this-page-link" href="{{page.editUrl}}"><span class="valentus-edit-github-icon" aria-hidden="true">{{> valentus-icon-github-inline}}</span> Edit this page</a>
</div>
{{/if}}
