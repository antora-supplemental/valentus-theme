{{!--
  HACK (interim paint-hold): hide the document until layered supplemental CSS has
  loaded, preference attrs are set, and web fonts are ready. Default UI paints
  site.css first; Valentus then applies site-extra / layout / visual / read-width /
  font-size (and often a site brand overlay). Google Fonts use display=swap, so
  releasing before font files arrive causes a FOUT width jump on refresh.

  Pending better upstream: compile theme + layout tokens into a single site.css
  and ship the FOUC preference contract in antora-ui-default (dark mode: !207;
  supplemental cascade: !213). Remove this hold when first paint no longer depends
  on post-site.css layers / remote webfonts.
--}}
<style>
html.adt-fouc-pending { visibility: hidden !important; }
</style>
<script>
document.documentElement.classList.add('adt-fouc-pending')
</script>
<link rel="stylesheet" href="{{{uiRootPath}}}/css/site-extra.css">
<meta name="dm-navbar" content="{{or site.keys.darkModeNavbar 'light'}}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">
<link rel="stylesheet" href="{{{uiRootPath}}}/css/site-doc-layout.css">
<link rel="stylesheet" href="{{{uiRootPath}}}/css/site-visual.css">
<link rel="stylesheet" href="{{{uiRootPath}}}/css/site-read-width.css">
<link rel="stylesheet" href="{{{uiRootPath}}}/css/site-font-size.css">
<link rel="stylesheet" href="{{{uiRootPath}}}/css/site-math.css">
{{!-- Preference FOUC: after stylesheet links so the parser has applied the cascade. --}}
<script>
(function () {
  const dmNavbar = document.querySelector('meta[name="dm-navbar"]')
  if (dmNavbar && dmNavbar.content) {
    document.documentElement.dataset.dmNavbar = dmNavbar.content
  }
  const MODE = 'antora-theme-mode'
  const LEGACY = 'antora-theme'
  function mode() {
    const m = localStorage.getItem(MODE)
    if (m === 'system' || m === 'dark' || m === 'light') return m
    const o = localStorage.getItem(LEGACY)
    if (o === 'dark' || o === 'light') return o
    return 'system'
  }
  function isDark() {
    const m = mode()
    if (m === 'dark') return true
    if (m === 'light') return false
    return window.matchMedia('(prefers-color-scheme: dark)').matches
  }
  if (isDark()) document.documentElement.classList.add('dark-theme')
})()
</script>
{{!-- read-width FOUC (same as ui-modules/packages/read-width/ui/js/adt-read-width-fouc.js) --}}
<script>
(function () {
  try {
    var w = localStorage.getItem('adt-read-width')
    document.documentElement.setAttribute(
      'data-adt-read-width',
      w === 'narrow' || w === 'comfortable' || w === 'wide' ? w : 'comfortable'
    )
  } catch (e) {
    document.documentElement.setAttribute('data-adt-read-width', 'comfortable')
  }
})()
</script>
{{!-- font-size FOUC (same as ui-modules/packages/font-size/ui/js/adt-font-size-fouc.js) --}}
<script>
(function () {
  try {
    var s = localStorage.getItem('adt-font-size')
    document.documentElement.setAttribute(
      'data-adt-font-size',
      s === 'small' || s === 'medium' || s === 'large' ? s : 'medium'
    )
  } catch (e) {
    document.documentElement.setAttribute('data-adt-font-size', 'medium')
  }
})()
</script>
{{!-- Webfont FOUT: kick loads, then release paint-hold (3s timeout if CDN stalls). --}}
<script>
(function () {
  var released = false
  function release () {
    if (released) return
    released = true
    document.documentElement.classList.remove('adt-fouc-pending')
  }
  var fallback = setTimeout(release, 3000)
  function finish () {
    clearTimeout(fallback)
    release()
  }
  if (!document.fonts || !document.fonts.load) {
    finish()
    return
  }
  Promise.all([
    document.fonts.load('400 1em "Source Sans 3"'),
    document.fonts.load('600 1em "Source Sans 3"'),
    document.fonts.load('500 1em "Plus Jakarta Sans"'),
    document.fonts.load('700 1em "Plus Jakarta Sans"'),
    document.fonts.load('400 1em "IBM Plex Mono"'),
  ])
    .then(function () { return document.fonts.ready })
    .then(finish, finish)
})()
</script>
{{#if page.origin.webUrl}}
<meta name="antora-repo-url" content="{{page.origin.webUrl}}">
{{/if}}
