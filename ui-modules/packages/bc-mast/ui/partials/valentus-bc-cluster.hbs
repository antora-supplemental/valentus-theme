{{!
  Component kicker + version control stay visible together (including with
  site-nav-tree). Mobile needs the component jump target; version sits to its right.
}}
<div class="valentus-bc-cluster" role="group" aria-label="Documentation component and version">
  <div class="valentus-bc-menu valentus-bc-menu-project">
    <button type="button" class="valentus-bc-kicker" data-valentus-toggle="valentus-bc-proj" aria-haspopup="listbox" aria-expanded="false" aria-label="Switch documentation component">
      <span class="valentus-bc-kicker-label">{{#if page.component}}{{{page.component.title}}}{{else}}{{{site.title}}}{{/if}}</span>
    </button>
    <ul class="valentus-bc-dropdown valentus-bc-dropdown--components" id="valentus-bc-proj" role="listbox" hidden>
      {{#each site.components}}
      <li role="none" class="valentus-bc-menu-item">
        <a href="{{{relativize ./url}}}" class="{{#if (eq this @root.page.component)}}is-current{{/if}}">{{{./title}}}</a>
      </li>
      {{/each}}
    </ul>
  </div>
  <span class="valentus-bc-cluster-gap" aria-hidden="true"> </span>
  {{#with (valentus-version-mode @root.page)}}
  {{#if (eq this 'menu')}}
  <div class="valentus-bc-menu valentus-bc-menu-version">
    <button type="button" class="valentus-bc-kicker valentus-bc-kicker--version" data-valentus-toggle="valentus-bc-ver" aria-haspopup="listbox" aria-expanded="false" aria-label="Select documentation version">
            <span class="valentus-bc-kicker-version">{{valentus-version-label @root.page.componentVersion fallback="Version"}}</span>
    </button>
    <ul class="valentus-bc-dropdown valentus-bc-dropdown--version" id="valentus-bc-ver" role="listbox" hidden>
      {{#if @root.page.versions}}
      {{#each @root.page.versions}}
      <li role="none" class="valentus-bc-menu-item">
        <a href="{{{relativize ./url}}}" class="valentus-bc-version-pill{{#if (eq ./version @root.page.version)}} is-current{{/if}}{{#if ./missing}} is-missing{{/if}}"{{#if (eq ./version @root.page.version)}} aria-current="page"{{/if}}>{{valentus-version-label this}}</a>
      </li>
      {{/each}}
      {{else if @root.page.componentVersion}}
      <li role="none" class="valentus-bc-menu-item">
        <a href="{{{relativize @root.page.componentVersion.url}}}" class="valentus-bc-version-pill is-current" aria-current="page">{{valentus-version-label @root.page.componentVersion}}</a>
      </li>
      {{/if}}
    </ul>
  </div>
  {{else if (eq this 'plain')}}
  <div class="valentus-bc-menu valentus-bc-menu-version valentus-bc-menu-version--plain">
    <span class="valentus-bc-version-plain" title="Documentation version">{{valentus-version-label @root.page.componentVersion}}</span>
  </div>
  {{/if}}
  {{/with}}
</div>
